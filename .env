PORT=3000

# Firebase Service Account Key (Upload this file separately to Render)
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Your main admin Telegram bot token (for sending alerts)
ADMIN_TELEGRAM_BOT_TOKEN=YOUR_ADMIN_BOT_TOKEN_HERE

# Platform wallet addresses for premium payments
TON_WALLET_ADDRESS=UQAXXXXXXXXXXXXXXXXXXXXXXXXXXXX
USDT_TON_WALLET_ADDRESS=UQXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Web App URL (for mini app link generation)
WEBAPP_BASE_URL=https://your-webapp-domain.com
